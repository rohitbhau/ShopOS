generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships  Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Tenants (Shops) ─────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  shopType  String   @default("retail") @map("shop_type")
  phone     String?
  email     String?
  address   String?
  gstin     String?
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  products    Product[]
  customers   Customer[]
  invoices    Invoice[]
  categories  Category[]

  @@map("tenants")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      Role     @default(OWNER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("memberships")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  VIEWER
}

// ─── Products ────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  categoryId   String?  @map("category_id")
  name         String
  description  String?
  sku          String?
  barcode      String?
  price        Decimal  @db.Decimal(10, 2)
  costPrice    Decimal? @db.Decimal(10, 2) @map("cost_price")
  taxRate      Decimal  @default(0) @db.Decimal(5, 2) @map("tax_rate")
  stock        Int      @default(0)
  minStock     Int      @default(0) @map("min_stock")
  unit         String   @default("pcs")
  imageUrl     String?  @map("image_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id])
  invoiceItems InvoiceItem[]

  @@map("products")
}

// ─── Customers ───────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  phone       String?
  email       String?
  address     String?
  outstanding Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("customers")
}

// ─── Invoices ────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  customerId    String?       @map("customer_id")
  invoiceNumber String        @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2) @map("tax_amount")
  discountAmount Decimal      @default(0) @db.Decimal(10, 2) @map("discount_amount")
  totalAmount   Decimal       @db.Decimal(10, 2) @map("total_amount")
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2) @map("paid_amount")
  paymentMethod String?       @map("payment_method")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id])
  items    InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  PAID
  PARTIAL
  CANCELLED
}

model InvoiceItem {
  id         String   @id @default(uuid())
  invoiceId  String   @map("invoice_id")
  productId  String?  @map("product_id")
  name       String
  quantity   Decimal  @db.Decimal(10, 3)
  price      Decimal  @db.Decimal(10, 2)
  taxRate    Decimal  @default(0) @db.Decimal(5, 2) @map("tax_rate")
  total      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}
