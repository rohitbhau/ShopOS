apps/mobile/android/.idea/
apps/mobile/android/captures/
apps/mobile/android/local.properties
apps/mobile/android/gradlew
apps/mobile/android/gradlew.bat
apps/mobile/android/key.properties
apps/mobile/android/app/debug/
apps/mobile/android/app/profile/
apps/mobile/android/app/release/

# Flutter Generated Files
apps/mobile/lib/gen/
apps/mobile/lib/**/*.g.dart
apps/mobile/lib/**/*.freezed.dart
apps/mobile/test/**/*.mocks.dart

# Node.js
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js
apps/admin/.next/
apps/admin/out/
apps/landing/.next/
apps/landing/out/

# Production builds
apps/admin/build/
apps/landing/build/
dist/
*.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
Desktop.ini
*.bak

# Supabase
packages/supabase/.branches/
packages/supabase/.temp/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/
*.lcov
.nyc_output/

