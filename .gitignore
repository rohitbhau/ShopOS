# ShopOS - Git Ignore

# Environment variables (NEVER commit secrets!)
.env
.env.local
.env.*.local
*.env
**/.env
**/.env.local

# Flutter
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
